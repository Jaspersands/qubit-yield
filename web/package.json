{
  "name": "qubityield-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && vite build --config vite.preview.config.ts",
    "preview": "vite preview --host 0.0.0.0",
